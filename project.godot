; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Simulator Game"
config/description="Enter an interesting project description here!"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.png"

[autoload]

GameData="*res://scripts/data/game_data.gd"
Inventory="*res://scripts/inventory.gd"
TimeManager="*res://scripts/time_manager.gd"
Weather="*res://scripts/weather.gd"
AudioManager="*res://scripts/audio_manager.gd"
SaveGame="*res://scripts/save_game.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/TileMapDual/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[gdunit4]

settings/test/test_lookup_folder="tests"

[gui]

theme/custom_font="res://assets/graphics/fonts/PixeloidSans.ttf"

